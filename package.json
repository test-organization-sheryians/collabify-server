{
  "name": "collabify-server",
  "scripts": {
    "dev": "sudo docker compose up -d && bun run --hot src/app/server.ts",
    "build": "bun build ./src/app/server.ts --outdir ./dist --target bun",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "gen": "bun run scripts/generate-schema.ts && graphql-codegen && bun run scripts/sync-schema.ts",
    "sync": "bun run scripts/sync-schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.966.0",
    "@hono/clerk-auth": "^3.0.3",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/pg": "^8.16.0",
    "bullmq": "^5.66.4",
    "dataloader": "^2.2.3",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.18.0",
    "hono": "^4.11.3",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.9.1",
    "nanoid": "3.3.4",
    "pg": "^8.16.3",
    "pg-listen": "^1.7.0",
    "pino": "^10.1.1",
    "pnpm": "^10.28.2",
    "svix": "^1.84.1",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "@types/k6": "^1.5.0",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.3.1",
    "globals": "^17.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "prisma": "^7.3.0",
    "typescript-eslint": "^8.52.0"
  }
}
