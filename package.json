{
  "name": "collabify-server",
  "scripts": {
    "dev": "sudo docker compose up -d && bun run --hot src/app/server.ts",
    "build": "bun build ./src/app/server.ts --outdir ./dist --target bun ",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "gen": "bun run scripts/generate-schema.ts && graphql-codegen && bun run scripts/sync-schema.ts",
    "sync": "bun run scripts/sync-schema.ts",
    "typecheck": "tsc --noEmit",
    "killall": "pkill -9 bun || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.987.0",
    "@aws-sdk/client-ses": "^3.987.0",
    "@graphql-codegen/cli": "^6.1.1",
    "@hono/clerk-auth": "^3.1.0",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "@sendgrid/mail": "^8.1.6",
    "@types/pg": "^8.16.0",
    "bullmq": "^5.68.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.12.0",
    "graphql-codegen": "^0.4.0",
    "graphql-scalars": "^1.25.0",
    "graphql-yoga": "^5.18.0",
    "hono": "^4.11.9",
    "hono-pino": "^0.10.3",
    "ioredis": "^5.9.2",
    "nanoid": "3.3.4",
    "pg": "^8.18.0",
    "pg-listen": "^1.7.0",
    "pino": "^10.3.1",
    "pnpm": "^10.29.3",
    "svix": "^1.84.1",
    "ulid": "^3.0.2",
    "uuid": "^13.0.0",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "@types/bun": "latest",
    "@types/ioredis": "^5.0.0",
    "@types/k6": "^1.6.0",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.4.0",
    "globals": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^7.4.0",
    "typescript-eslint": "^8.55.0"
  }
}
