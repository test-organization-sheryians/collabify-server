// This is your Prisma schema file.
// V5: STRICT SINGLE ROLE & OPTIMIZED INDEXES

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// 0. SHARED ENUMS
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Structural Role (Hard-coded logic)
enum RoleType {
  OWNER // Cannot be removed, pays the bills
  MEMBER // Standard user (uses CustomRole for permissions)
  GUEST // Restricted access
}

enum PolicyEffect {
  ALLOW
  DENY
}

// -----------------------------------------------------------------------------
// 1. IDENTITY (GLOBAL)
// -----------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  clerkId      String     @unique @map("clerk_id")
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String?    @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  sessions         UserSession[]
  keys             UserKey[]
  workspaceMembers WorkspaceMember[]
  auditLogs        AuditLog[]

  // Direct Resource Interactions (The "Hybrid" Fix)
  projectMembers   ProjectMember[]
  resourcePolicies ResourcePolicy[]

  // 13. SUBSCRIPTIONS & QUOTAS
  subscription Subscription?
  usageRecords UsageRecord[]

  // Activity
  assignedTasks    Task[]            @relation("TaskAssignee")
  reportedTasks    Task[]            @relation("TaskReporter")
  chatMembers      ChatMember[]
  sentMessages     ChatMessage[]
  messageReactions MessageReaction[]
  meetParticipants MeetParticipant[]

  authoredPages Page[]
  uploadedFiles VaultFile[]

  notifications           Notification[]
  sentNotifications       Notification[]            @relation("NotificationActor")
  aiConversations         CollabifyAiConversation[]
  notificationPreferences NotificationPreference[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Optional metadata
  deviceInfo String? @map("device_info")
  ipAddress  String? @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model UserKey {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  provider   String
  providerId String @map("provider_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_keys")
}

// -----------------------------------------------------------------------------
// 2. WORKSPACE (CONTAINER)
// -----------------------------------------------------------------------------

model Workspace {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  logoUrl         String? @map("logo_url")
  domainWhitelist String? @map("domain_whitelist")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  auditLogs   AuditLog[]
  customRoles CustomRole[]
  projects    Project[]

  // Denormalized relations for "Delete Workspace" cascades
  pages       Page[]
  vaultFiles  VaultFile[]
  whiteboards Whiteboard[]
  chats       ChatChannel[]
  tasks       Task[]

  usageRecords            UsageRecord[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  // 1. Structural Role (Billing/Ownership)
  role RoleType @default(MEMBER)

  // 2. Permission Role (RBAC) - STRICT SINGLE ROLE ENFORCEMENT
  // We removed the 'MemberRole' join table. Now it is a direct link.
  customRoleId String? @map("custom_role_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  customRole CustomRole? @relation(fields: [customRoleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId]) // Optimized for "List My Workspaces"
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  email       String
  token       String   @unique
  role        RoleType @default(MEMBER) // Structural
  inviterId   String   @map("inviter_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("workspace_invites")
}

// -----------------------------------------------------------------------------
// 3. ENTERPRISE PERMISSIONS (HYBRID)
// -----------------------------------------------------------------------------

model SystemPermission {
  id          String @id
  description String
  module      String

  inRoles RolePermission[]

  @@map("system_permissions")
}

model CustomRole {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions RolePermission[]

  // Inverse Relations for the STRICT SINGLE ROLE model
  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId]) // LOCK: Allows ProjectMember to verify Workspace scope
  @@map("custom_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       CustomRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// REMOVED: MemberRole (Table Deleted - Redundant)

model ResourcePolicy {
  id     String @id @default(cuid())
  userId String @map("user_id")

  resourceId   String @map("resource_id")
  resourceType String @map("resource_type") // "PROJECT", "PAGE", "BOARD"

  permissionId String       @map("permission_id")
  effect       PolicyEffect

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // REMOVED: workspaceMemberId (Redundant)

  @@unique([userId, resourceId, permissionId])
  @@index([resourceId, resourceType])
  @@map("resource_policies")
}

// -----------------------------------------------------------------------------
// 4. PROJECT (ISOLATION UNIT)
// -----------------------------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  key         String  @map("key")
  name        String
  description String?
  isPrivate   Boolean @default(true) @map("is_private")
  isArchived  Boolean @default(false) @map("is_archived")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]

  pages        Page[]
  vaultFolders VaultFolder[]
  vaultFiles   VaultFile[]
  whiteboards  Whiteboard[]
  chats        ChatChannel[]
  boards       Board[]
  meets        Meet[]
  aiChats      CollabifyAiConversation[]

  counters                ProjectCounter[]
  tasks                   Task[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@unique([workspaceId, key])
  @@unique([id, workspaceId]) // LOCK: Allows ProjectMember to verify Workspace scope
  @@index([workspaceId])
  @@map("projects")
}

model ProjectCounter {
  projectId   String @map("project_id")
  counterType String @map("counter_type")
  currentVal  Int    @default(0) @map("current_val")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, counterType])
  @@map("project_counters")
}

model ProjectMember {
  id String @id @default(cuid())

  // LOCK: Explicit Workspace ID to act as the "Bridge" regarding scope
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  userId      String @map("user_id")

  // STRICT SINGLE ROLE ENFORCEMENT
  // This is the ONLY place a role lives for a project member.
  projectRoleId String? @map("project_role_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  // LOCK 1: The Project must match this Workspace
  project Project @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  // LOCK 2: The Role must match THIS SAME Workspace
  projectRole CustomRole? @relation(fields: [projectRoleId, workspaceId], references: [id, workspaceId])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // REMOVED: workspaceMemberId (Optional relation removed for cleaner userId-based queries)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// REMOVED: ProjectMemberRole (Table Deleted - Redundant)

// -----------------------------------------------------------------------------
// 5. PAGES (DOCS)
// -----------------------------------------------------------------------------

model Page {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  parentPageId  String? @map("parent_page_id")
  title         String  @default("Untitled")
  emojiIcon     String? @map("emoji_icon")
  coverImageUrl String? @map("cover_image_url")
  isLocked      Boolean @default(false) @map("is_locked")

  contentS3Key   String? @map("content_s3_key")
  contentVersion Int     @default(1) @map("content_version")

  authorUserId String? @map("author_user_id") // FIX: Optional for SetNull

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull) // FIX

  parentPage Page?  @relation("PageHierarchy", fields: [parentPageId], references: [id])
  childPages Page[] @relation("PageHierarchy")

  @@map("pages")
}

// -----------------------------------------------------------------------------
// 6. VAULT (FILES)
// -----------------------------------------------------------------------------

model VaultFolder {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  parentFolderId String? @map("parent_folder_id")
  name           String

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder VaultFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  childFolders VaultFolder[] @relation("FolderHierarchy")
  files        VaultFile[]

  @@map("vault_folders")
}

model VaultFile {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  projectId      String  @map("project_id")
  folderId       String? @map("folder_id")
  uploaderUserId String? @map("uploader_user_id")

  name      String
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")
  s3Key     String @map("s3_key")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    VaultFolder? @relation(fields: [folderId], references: [id])
  uploader  User?        @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull) // FIX

  @@index([projectId, folderId])
  @@map("vault_files")
}

// -----------------------------------------------------------------------------
// 7. WHITEBOARD (CANVAS)
// -----------------------------------------------------------------------------

model Whiteboard {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  title         String
  snapshotS3Key String? @map("snapshot_s3_key")

  contentS3Key   String? @map("content_s3_key")
  contentVersion Int     @default(1) @map("content_version")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("whiteboards")
}

// -----------------------------------------------------------------------------
// 8. BOARDS & TASKS
// -----------------------------------------------------------------------------

enum BoardType {
  KANBAN
  LIST
  TIMELINE
}

enum BoardViewStyle {
  NORMAL
  STANDARD
}

model Board {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  name      String
  type      BoardType      @default(KANBAN)
  viewStyle BoardViewStyle @default(NORMAL) @map("view_style")
  config    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("boards")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  boardId     String @map("board_id")
  seqId       Int    @map("seq_id")

  title       String
  description Json?
  statusName  String       @default("Todo") @map("status_name")
  priority    TaskPriority @default(MEDIUM)

  assigneeUserId String? @map("assignee_user_id")
  reporterUserId String? @map("reporter_user_id") // FIX: Optional for SetNull
  parentTaskId   String? @map("parent_task_id")

  startDate DateTime? @map("start_date")
  dueDate   DateTime? @map("due_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  assignee User? @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull) // FIX
  reporter User? @relation("TaskReporter", fields: [reporterUserId], references: [id], onDelete: SetNull) // FIX

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks   Task[] @relation("Subtasks")

  @@unique([projectId, seqId])
  @@index([projectId, boardId]) // OPTIMIZED: Kanban Load
  @@index([projectId, assigneeUserId]) // OPTIMIZED: "My Tasks"
  @@map("tasks")
}

// -----------------------------------------------------------------------------
// 9. CHAT
// -----------------------------------------------------------------------------

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
}

model ChatChannel {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  projectId   String?     @map("project_id")
  type        ChannelType @default(PUBLIC)
  name        String?
  topic       String?
  isArchived  Boolean     @default(false) @map("is_archived")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  members  ChatMember[]
  messages ChatMessage[]

  @@unique([projectId, name])
  @@map("chat_channels")
}

model ChatMember {
  id            String   @id @default(cuid())
  channelId     String   @map("channel_id")
  userId        String   @map("user_id")
  joinedAt      DateTime @default(now()) @map("joined_at")
  lastReadMsgId String?  @map("last_read_msg_id")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("chat_members")
}

model ChatMessage {
  id            String  @id @default(cuid())
  channelId     String  @map("channel_id")
  senderUserId  String? @map("sender_user_id")
  content       String
  attachmentIds Json?
  isSystem      Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull) // FIX

  reactions MessageReaction[]

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@map("message_reactions")
}

// -----------------------------------------------------------------------------
// 10. MEET (CALLS)
// -----------------------------------------------------------------------------

enum MeetStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Meet {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  title     String
  startTime DateTime   @map("start_time")
  status    MeetStatus @default(SCHEDULED)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants MeetParticipant[]

  @@index([projectId])
  @@map("meets")
}

model MeetParticipant {
  id       String    @id @default(cuid())
  meetId   String    @map("meet_id")
  userId   String    @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  meet Meet @relation(fields: [meetId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // REMOVED: workspaceMemberId (Redundant)

  @@map("meet_participants")
}

// -----------------------------------------------------------------------------
// 11. COLLABIFY AI
// -----------------------------------------------------------------------------

model CollabifyAiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  messages CollabifyAiMessage[]

  @@map("collabify_ai_conversations")
}

model CollabifyAiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  citationData   Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation CollabifyAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("collabify_ai_messages")
}

// -----------------------------------------------------------------------------
// -----------------------------------------------------------------------------
// 12. NOTIFICATIONS (v2 - ARCHITECTURE ALIGNED)
// -----------------------------------------------------------------------------

enum NotificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model NotificationOutbox {
  id        BigInt @id @default(autoincrement()) // BigInt for infinite scale
  eventType String @map("event_type") // e.g. "workspace.invite", "task.assigned"

  // The Payload contains EVERYTHING needed to reconstruct the event.
  // schema: { actorId, entityId, title, diff: {}, etc. }
  payload Json

  status NotificationStatus @default(PENDING)

  // For Deduplication/Idempotency
  deduplicationId String? @unique @map("deduplication_id")

  // For "Hybrid Poller" performance, we index status + createdAt
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  errorLog    Json?     @map("error_log")

  @@index([status, createdAt]) // The Poller's bread and butter
  @@map("notification_outbox")
}

model NotificationPreference {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Scope: Minimalist approach. 
  // If workspaceId is NULL and projectId is NULL -> Global Preference
  workspaceId String? @map("workspace_id")
  projectId   String? @map("project_id")

  // The category key, e.g., "chat_mentions", "task_updates", "marketing"
  categoryKey String @map("category_key")

  // Channels
  emailEnabled Boolean @default(true) @map("email_enabled")
  pushEnabled  Boolean @default(true) @map("push_enabled")
  inAppEnabled Boolean @default(true) @map("in_app_enabled")

  updatedAt DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Optional relations for cascade deletes
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, projectId, categoryKey], map: "unique_user_preference_scope")
  @@map("notification_preferences")
}

model Notification {
  id              String  @id @default(cuid())
  recipientUserId String  @map("recipient_user_id")
  actorId         String? @map("actor_id") // Who triggered it?

  // 1. POLYMORPHIC / GENERIC REFERENCES (Replaces taskId, pageId, etc.)
  // Allows frontend to route to /<entityType>/<entityId>
  entityType String @map("entity_type") // "TASK", "PAGE", "WORKSPACE"
  entityId   String @map("entity_id")

  // 2. GROUPING & BATCHING
  // Used for "Digest" generation or UI grouping ("System", "Social")
  category String @default("general")

  // 3. RICH CONTENT MODEL (JSON)
  // Contains pre-computed strings for fast read: { title: "Draft", subtitle: "X assigned Y" }
  // Also contains 'actions': [{ label: "Approve", url: "..." }]
  data Json

  isRead     Boolean @default(false) @map("is_read")
  isArchived Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")

  recipient User  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?
  project     Project?   @relation(fields: [projectId], references: [id])
  projectId   String?

  // 1. "My Unread Notifications" (Most common query)
  @@index([recipientUserId, isRead, createdAt(sort: Desc)])
  // 2. "Cursor Pagination" for full history
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  actorUserId    String? @map("actor_user_id")
  action         String
  targetResource String  @map("target_resource")
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

// -----------------------------------------------------------------------------
// 13. SUBSCRIPTIONS & QUOTAS
// -----------------------------------------------------------------------------

model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique // "free", "pro_user"
  name        String
  description String?
  isActive    Boolean @default(true) // Soft delete for plans

  // Normalized Limits
  limits        PlanLimit[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // Critical for cache invalidation

  @@map("plans")
}

model PlanLimit {
  id     String @id @default(cuid())
  planId String @map("plan_id")

  // "max_workspaces", "max_members_per_workspace", "storage_limit_mb"
  resourceKey String @map("resource_key")
  limitValue  Int    @map("limit_value") // -1 = Unlimited

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // INDEXING: Fast lookup for a specific checking a specific rule
  @@unique([planId, resourceKey])
  @@map("plan_limits")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique @map("user_id") // ONE active subscription per user

  planId String @map("plan_id")
  status String @default("ACTIVE") // ACTIVE, CANCELED, PAST_DUE

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  // Custom overrides for specific users (Sales/Support enabled)
  overrides SubscriptionOverride[]

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status, endDate]) // For cron jobs finding expiring subs
  @@map("subscriptions")
}

model SubscriptionOverride {
  id             String @id @default(cuid())
  subscriptionId String @map("subscription_id")
  resourceKey    String @map("resource_key")
  limitValue     Int    @map("limit_value")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, resourceKey])
  @@map("subscription_overrides")
}

model UsageRecord {
  id String @id @default(cuid())

  // We track usage per SCOPE.
  // Some limits are User-scoped (e.g. Created Workspaces)
  // Some are Workspace-scoped (e.g. Storage Used, Members)
  userId      String? @map("user_id")
  workspaceId String? @map("workspace_id")

  resourceKey String @map("resource_key")
  currentVal  Int    @default(0) @map("current_val")

  // Lazy Reset Logic: Checked on READ. If now > resetAt, value = 0.
  resetAt DateTime? @map("reset_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // INDEXING: The most critical index.
  @@unique([userId, resourceKey])
  @@unique([workspaceId, resourceKey])
  @@map("usage_records")
}
