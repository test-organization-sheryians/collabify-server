// This is your Prisma schema file.
// V3: ENTERPRISE HYBRID PERMISSIONS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// 0. SHARED ENUMS
// -----------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// Workspace-level roles (Structural)
enum RoleType {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

// Permission Effect (AWS Style)
enum PolicyEffect {
  ALLOW
  DENY
}

// -----------------------------------------------------------------------------
// 1. IDENTITY (GLOBAL)
// -----------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String?    @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  sessions         UserSession[]
  keys             UserKey[]
  workspaceMembers WorkspaceMember[]
  auditLogs        AuditLog[] // Actor

  // Polymorphic Notifications (Recipient)
  notifications     Notification[]
  sentNotifications Notification[] @relation("NotificationActor")

  // Global AI Memory
  aiConversations CollabifyAiConversation[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  deviceInfo String?  @map("device_info")
  ipAddress  String?  @map("ip_address")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model UserKey {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  provider   String // "google", "github"
  providerId String @map("provider_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_keys")
}

// -----------------------------------------------------------------------------
// 2. WORKSPACE (CONTAINER)
// -----------------------------------------------------------------------------

model Workspace {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  logoUrl         String? @map("logo_url")
  domainWhitelist String? @map("domain_whitelist")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  auditLogs AuditLog[]

  // Permission System
  customRoles CustomRole[]

  // Structural Containers
  projects Project[]

  // Denormalized Lookups (for Sharding/Access)
  pages       Page[]
  vaultFiles  VaultFile[]
  whiteboards Whiteboard[]
  chats       ChatChannel[]
  tasks       Task[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  // Structural Role (Membership Type)
  role RoleType @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Custom Role Assignments (RBAC)
  assignedRoles MemberRole[]

  // Resource Overrides (ABAC)
  policies ResourcePolicy[]

  // Activity
  projectMembers   ProjectMember[]
  messageReactions MessageReaction[]
  meetParticipants MeetParticipant[]

  assignedTasks Task[] @relation("TaskAssignee")
  reportedTasks Task[] @relation("TaskReporter")

  chatMembers  ChatMember[]
  chatMessages ChatMessage[]

  pages      Page[]
  vaultFiles VaultFile[]

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String
  token       String    @unique
  role        RoleType  @default(MEMBER)
  inviterId   String    @map("inviter_id")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("workspace_invites")
}

// -----------------------------------------------------------------------------
// 3. ENTERPRISE PERMISSIONS (HYBRID)
// -----------------------------------------------------------------------------

// The Immutable Menu of Capabilities (Developer Defined)
model SystemPermission {
  id          String @id // e.g. "FILES_EDIT", "TASKS_DELETE"
  description String
  module      String // e.g. "VAULT", "TASKS"

  // Relations
  inRoles RolePermission[]

  @@map("system_permissions")
}

// User-Defined Roles (RBAC)
model CustomRole {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Relations
  permissions RolePermission[]
  members     MemberRole[]

  @@unique([workspaceId, name])
  @@map("custom_roles")
}

// Join Table: CustomRole <-> SystemPermission
model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       CustomRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// Join Table: WorkspaceMember <-> CustomRole (Users can have multiple roles)
model MemberRole {
  memberId String @map("workspace_member_id")
  roleId   String @map("role_id")

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   CustomRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

// The Granular Override (ABAC / ACL)
// "For this User, on this specific Resource, ALLOW/DENY this specific Permission"
model ResourcePolicy {
  id       String @id @default(cuid())
  memberId String @map("workspace_member_id")

  // Polymorphic Resource Pointer
  resourceId   String @map("resource_id")
  resourceType String @map("resource_type") // "PROJECT", "PAGE", "BOARD"

  permissionId String       @map("permission_id") // Specific action being overridden
  effect       PolicyEffect // ALLOW / DENY

  createdAt DateTime @default(now()) @map("created_at")

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resourceId, permissionId]) // Only one policy per action per resource per user
  @@index([resourceId, resourceType])
  @@map("resource_policies")
}

// -----------------------------------------------------------------------------
// 4. PROJECT (ISOLATION UNIT)
// -----------------------------------------------------------------------------

model Project {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  key         String  @map("key")
  name        String
  description String?
  isPrivate   Boolean @default(true) @map("is_private")
  isArchived  Boolean @default(false) @map("is_archived")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]

  // Resource Modules
  pages        Page[]
  vaultFolders VaultFolder[]
  vaultFiles   VaultFile[]
  whiteboards  Whiteboard[]
  chats        ChatChannel[]
  boards       Board[]
  meets        Meet[]
  aiChats      CollabifyAiConversation[]

  // Counters
  counters ProjectCounter[]
  tasks    Task[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectCounter {
  projectId   String @map("project_id")
  counterType String @map("counter_type")
  currentVal  Int    @default(0) @map("current_val")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, counterType])
  @@map("project_counters")
}

model ProjectMember {
  id                String @id @default(cuid())
  projectId         String @map("project_id")
  workspaceMemberId String @map("workspace_member_id")

  // Note: Project-level grouping only. Permissions come from CustomRoles/Policies.
  // We remove 'roleId' here because Roles are now global or granularly applied?
  // Actually, Users might need Project-Specific Roles (e.g. "Admin of Project A").
  // For hybrid model, we can attach MemberRoles specifically scoped to a project context?
  // Simplification for now: Project Membership is just Access. 
  // Detailed permissions are handled via ResourcePolicies or Workspace-level Roles.
  // OR, we can re-introduce a Project-Scoped Role binding.
  // Re-introducing simple linkage for membership tracking.

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, workspaceMemberId])
  @@index([workspaceMemberId])
  @@map("project_members")
}

// -----------------------------------------------------------------------------
// 5. PAGES (DOCS) - S3 BACKED
// -----------------------------------------------------------------------------

model Page {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  parentPageId  String? @map("parent_page_id")
  title         String  @default("Untitled")
  emojiIcon     String? @map("emoji_icon")
  coverImageUrl String? @map("cover_image_url")
  isLocked      Boolean @default(false) @map("is_locked")

  contentS3Key   String? @map("content_s3_key")
  contentVersion Int     @default(1) @map("content_version")

  authorMemberId String @map("author_member_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    WorkspaceMember @relation(fields: [authorMemberId], references: [id])

  parentPage Page?  @relation("PageHierarchy", fields: [parentPageId], references: [id])
  childPages Page[] @relation("PageHierarchy")

  notifications Notification[]

  @@index([projectId])
  @@index([workspaceId])
  @@map("pages")
}

// -----------------------------------------------------------------------------
// 6. VAULT (FILES) - S3 BACKED
// -----------------------------------------------------------------------------

model VaultFolder {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  parentFolderId String? @map("parent_folder_id")
  name           String

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder VaultFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  childFolders VaultFolder[] @relation("FolderHierarchy")
  files        VaultFile[]

  @@map("vault_folders")
}

model VaultFile {
  id               String  @id @default(cuid())
  workspaceId      String  @map("workspace_id")
  projectId        String  @map("project_id")
  folderId         String? @map("folder_id")
  uploaderMemberId String? @map("uploader_member_id")

  name      String
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")
  s3Key     String @map("s3_key")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    VaultFolder?     @relation(fields: [folderId], references: [id])
  uploader  WorkspaceMember? @relation(fields: [uploaderMemberId], references: [id])

  @@index([projectId, folderId])
  @@map("vault_files")
}

// -----------------------------------------------------------------------------
// 7. WHITEBOARD (CANVAS) - S3 BACKED
// -----------------------------------------------------------------------------

model Whiteboard {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  title         String
  snapshotS3Key String? @map("snapshot_s3_key")

  contentS3Key   String? @map("content_s3_key")
  contentVersion Int     @default(1) @map("content_version")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("whiteboards")
}

// -----------------------------------------------------------------------------
// 8. BOARDS & TASKS
// -----------------------------------------------------------------------------

enum BoardType {
  KANBAN
  LIST
  TIMELINE
}

enum BoardViewStyle {
  NORMAL
  STANDARD
}

model Board {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  name      String
  type      BoardType      @default(KANBAN)
  viewStyle BoardViewStyle @default(NORMAL) @map("view_style")
  config    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("boards")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  boardId     String @map("board_id")
  seqId       Int    @map("seq_id")

  title       String
  description Json?
  statusName  String       @default("Todo") @map("status_name")
  priority    TaskPriority @default(MEDIUM)

  assigneeMemberId String? @map("assignee_member_id")
  reporterMemberId String  @map("reporter_member_id")
  parentTaskId     String? @map("parent_task_id")

  startDate DateTime? @map("start_date")
  dueDate   DateTime? @map("due_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  assignee WorkspaceMember? @relation("TaskAssignee", fields: [assigneeMemberId], references: [id])
  reporter WorkspaceMember  @relation("TaskReporter", fields: [reporterMemberId], references: [id])

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks   Task[] @relation("Subtasks")

  notifications Notification[]

  @@unique([projectId, seqId])
  @@index([workspaceId])
  @@index([boardId])
  @@index([assigneeMemberId])
  @@map("tasks")
}

// -----------------------------------------------------------------------------
// 9. CHAT
// -----------------------------------------------------------------------------

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
}

model ChatChannel {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  projectId   String?     @map("project_id")
  type        ChannelType @default(PUBLIC)
  name        String?
  topic       String?
  isArchived  Boolean     @default(false) @map("is_archived")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  members  ChatMember[]
  messages ChatMessage[]

  @@unique([projectId, name])
  @@map("chat_channels")
}

model ChatMember {
  id            String   @id @default(cuid())
  channelId     String   @map("channel_id")
  memberId      String   @map("workspace_member_id")
  joinedAt      DateTime @default(now()) @map("joined_at")
  lastReadMsgId String?  @map("last_read_msg_id")

  channel ChatChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([channelId, memberId])
  @@map("chat_members")
}

model ChatMessage {
  id             String  @id @default(cuid())
  channelId      String  @map("channel_id")
  senderMemberId String? @map("sender_member_id")
  content        String
  attachmentIds  Json?
  isSystem       Boolean @default(false) @map("is_system")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  channel ChatChannel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender  WorkspaceMember? @relation(fields: [senderMemberId], references: [id])

  reactions     MessageReaction[]
  notifications Notification[]

  @@index([channelId, createdAt])
  @@map("chat_messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  memberId  String   @map("workspace_member_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@map("message_reactions")
}

// -----------------------------------------------------------------------------
// 10. MEET (CALLS)
// -----------------------------------------------------------------------------

enum MeetStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Meet {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  title     String
  startTime DateTime   @map("start_time")
  status    MeetStatus @default(SCHEDULED)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants MeetParticipant[]

  @@index([projectId])
  @@map("meets")
}

model MeetParticipant {
  id       String    @id @default(cuid())
  meetId   String    @map("meet_id")
  memberId String    @map("workspace_member_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  meet   Meet            @relation(fields: [meetId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("meet_participants")
}

// -----------------------------------------------------------------------------
// 11. COLLABIFY AI
// -----------------------------------------------------------------------------

model CollabifyAiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // Global Owner
  projectId String?  @map("project_id") // Optional Context
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  messages CollabifyAiMessage[]

  @@map("collabify_ai_conversations")
}

model CollabifyAiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String // "user", "assistant"
  content        String
  citationData   Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation CollabifyAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("collabify_ai_messages")
}

// -----------------------------------------------------------------------------
// 12. NOTIFICATIONS & AUDIT
// -----------------------------------------------------------------------------

model Notification {
  id              String  @id @default(cuid())
  recipientUserId String  @map("recipient_user_id")
  actorId         String? @map("actor_id") // User ID (Global)

  // Polymorphic Targets
  taskId        String? @map("task_id")
  chatMessageId String? @map("chat_message_id")
  pageId        String? @map("page_id")

  type      String // "MENTION", "ASSIGN", "SYSTEM"
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  recipient User  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  chatMessage ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  page        Page?        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, isRead])
  @@map("notifications")
}

model AuditLog {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  actorUserId    String? @map("actor_user_id")
  action         String
  targetResource String  @map("target_resource") // "Project:123"
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}
