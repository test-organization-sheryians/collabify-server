generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleType {
  OWNER
  MEMBER
  GUEST
}

enum PolicyEffect {
  ALLOW
  DENY
}

model User {
  id           String     @id @unique
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String?    @map("full_name")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  sessions         UserSession[]
  keys             UserKey[]
  workspaceMembers WorkspaceMember[]
  auditLogs        AuditLog[]

  projectMembers   ProjectMember[]
  resourcePolicies ResourcePolicy[]

  subscription Subscription?
  usageRecords UsageRecord[]

  assignedTasks    Task[]            @relation("TaskAssignee")
  reportedTasks    Task[]            @relation("TaskReporter")
  chatMembers      ChatMember[]
  sentMessages     ChatMessage[]
  messageReactions MessageReaction[]
  meetParticipants MeetParticipant[]

  authoredPages Page[]
  uploadedFiles VaultFile[]

  notifications           Notification[]
  sentNotifications       Notification[]            @relation("NotificationActor")
  aiConversations         CollabifyAiConversation[]
  notificationPreferences NotificationPreference[]

  @@index([email])
  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  deviceInfo String? @map("device_info")
  ipAddress  String? @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model UserKey {
  id         String @id @default(cuid())
  userId     String @map("user_id")
  provider   String
  providerId String @map("provider_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("user_keys")
}

model Workspace {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  logoUrl         String? @map("logo_url")
  domainWhitelist String? @map("domain_whitelist")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members     WorkspaceMember[]
  invites     WorkspaceInvite[]
  auditLogs   AuditLog[]
  customRoles CustomRole[]
  projects    Project[]

  pages       Page[]
  vaultFiles  VaultFile[]
  whiteboards Whiteboard[]
  chats       ChatChannel[]
  tasks       Task[]

  usageRecords            UsageRecord[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@index([slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  userId      String @map("user_id")

  role RoleType @default(MEMBER)

  customRoleId String? @map("custom_role_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  customRole CustomRole? @relation(fields: [customRoleId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  email       String
  token       String   @unique
  role        RoleType @default(MEMBER)
  inviterId   String   @map("inviter_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("workspace_invites")
}

model SystemPermission {
  id          String @id
  description String
  module      String

  inRoles RolePermission[]

  @@map("system_permissions")
}

model CustomRole {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  permissions RolePermission[]

  workspaceMembers WorkspaceMember[]
  projectMembers   ProjectMember[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@map("custom_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       CustomRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ResourcePolicy {
  id     String @id @default(cuid())
  userId String @map("user_id")

  resourceId   String @map("resource_id")
  resourceType String @map("resource_type")

  permissionId String       @map("permission_id")
  effect       PolicyEffect

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId, permissionId])
  @@index([resourceId, resourceType])
  @@map("resource_policies")
}

model Project {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  key         String  @map("key")
  name        String
  description String?
  isPrivate   Boolean @default(true) @map("is_private")
  isArchived  Boolean @default(false) @map("is_archived")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   ProjectMember[]

  pages        Page[]
  vaultFolders VaultFolder[]
  vaultFiles   VaultFile[]
  whiteboards  Whiteboard[]
  chats        ChatChannel[]
  boards       Board[]
  meets        Meet[]
  aiChats      CollabifyAiConversation[]

  counters                ProjectCounter[]
  tasks                   Task[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@unique([workspaceId, key])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("projects")
}

model ProjectCounter {
  projectId   String @map("project_id")
  counterType String @map("counter_type")
  currentVal  Int    @default(0) @map("current_val")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, counterType])
  @@map("project_counters")
}

model ProjectMember {
  id String @id @default(cuid())

  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  userId        String  @map("user_id")
  projectRoleId String? @map("project_role_id")

  joinedAt DateTime @default(now()) @map("joined_at")

  project Project @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  projectRole CustomRole? @relation(fields: [projectRoleId, workspaceId], references: [id, workspaceId])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Page {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  parentPageId  String? @map("parent_page_id")
  title         String  @default("Untitled")
  emojiIcon     String? @map("emoji_icon")
  coverImageUrl String? @map("cover_image_url")
  isLocked      Boolean @default(false) @map("is_locked")

  contentS3Key   String? @map("content_s3_key")
  contentVersion Int     @default(1) @map("content_version")

  authorUserId String? @map("author_user_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  parentPage Page?  @relation("PageHierarchy", fields: [parentPageId], references: [id])
  childPages Page[] @relation("PageHierarchy")

  @@map("pages")
}

model VaultFolder {
  id             String  @id @default(cuid())
  projectId      String  @map("project_id")
  parentFolderId String? @map("parent_folder_id")
  name           String

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentFolder VaultFolder?  @relation("FolderHierarchy", fields: [parentFolderId], references: [id])
  childFolders VaultFolder[] @relation("FolderHierarchy")
  files        VaultFile[]

  @@map("vault_folders")
}

model VaultFile {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  projectId      String  @map("project_id")
  folderId       String? @map("folder_id")
  uploaderUserId String? @map("uploader_user_id")

  name      String
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")
  s3Key     String @map("s3_key")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder    VaultFolder? @relation(fields: [folderId], references: [id])
  uploader  User?        @relation(fields: [uploaderUserId], references: [id], onDelete: SetNull)

  @@index([projectId, folderId])
  @@map("vault_files")
}

model Whiteboard {
  id            String  @id @default(cuid())
  workspaceId   String  @map("workspace_id")
  projectId     String  @map("project_id")
  title         String
  snapshotS3Key String? @map("snapshot_s3_key")

  contentS3Key   String? @map("content_s3_key")
  contentVersion Int     @default(1) @map("content_version")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("whiteboards")
}

enum BoardType {
  KANBAN
  LIST
  TIMELINE
}

enum BoardViewStyle {
  NORMAL
  STANDARD
}

model Board {
  id        String         @id @default(cuid())
  projectId String         @map("project_id")
  name      String
  type      BoardType      @default(KANBAN)
  viewStyle BoardViewStyle @default(NORMAL) @map("view_style")
  config    Json?

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("boards")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String @id @default(cuid())
  workspaceId String @map("workspace_id")
  projectId   String @map("project_id")
  boardId     String @map("board_id")
  seqId       Int    @map("seq_id")

  title       String
  description Json?
  statusName  String       @default("Todo") @map("status_name")
  priority    TaskPriority @default(MEDIUM)

  assigneeUserId String? @map("assignee_user_id")
  reporterUserId String? @map("reporter_user_id")
  parentTaskId   String? @map("parent_task_id")

  startDate DateTime? @map("start_date")
  dueDate   DateTime? @map("due_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)

  assignee User? @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  reporter User? @relation("TaskReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  parentTask Task?  @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks   Task[] @relation("Subtasks")

  @@unique([projectId, seqId])
  @@index([projectId, boardId])
  @@index([projectId, assigneeUserId])
  @@map("tasks")
}

enum ChannelType {
  PUBLIC
  PRIVATE
  DM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model OutboxMessage {
  id          BigInt       @id @default(autoincrement())
  messageId   String       @unique @map("message_id")
  channelId   String       @map("channel_id")
  payload     Json
  status      OutboxStatus @default(PENDING)
  errorLog    Json?        @map("error_log")
  retryCount  Int          @default(0) @map("retry_count")
  createdAt   DateTime     @default(now()) @map("created_at")
  processedAt DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@map("chat_outbox_messages")
}

model ChatChannel {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  projectId   String?     @map("project_id")
  type        ChannelType @default(PUBLIC)
  name        String?
  topic       String?
  isArchived  Boolean     @default(false) @map("is_archived")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  members  ChatMember[]
  messages ChatMessage[]

  @@unique([projectId, name])
  @@map("chat_channels")
}

model ChatMember {
  id        String @id @default(cuid())
  channelId String @map("channel_id")
  userId    String @map("user_id")

  // Read State
  lastReadMsgId      String?  @map("last_read_msg_id") // Blue Tick
  lastDeliveredMsgId String?  @map("last_delivered_msg_id") // Double Tick
  lastReadAt         DateTime @default(now()) @map("last_read_at")

  // Metadata
  joinedAt DateTime @default(now()) @map("joined_at")
  role     String   @default("MEMBER")
  isMuted  Boolean  @default(false) @map("is_muted")

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@map("chat_members")
}

model ChatMessage {
  id           String @id // ULID
  channelId    String @map("channel_id")
  authorUserId String @map("author_user_id")

  // Sequencing (The Hybrid Link)
  streamId String @map("stream_id")

  // Threading
  parentMessageId String? @map("parent_message_id")
  replyCount      Int     @default(0) @map("reply_count")

  // Content
  content  Json // Rich Text / Blocks
  type     String @default("TEXT")
  metadata Json? // Attachments, embeds

  // Lifecycle
  isEdited  Boolean   @default(false) @map("is_edited")
  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  channel       ChatChannel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author        User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  parentMessage ChatMessage?      @relation("ThreadReplies", fields: [parentMessageId], references: [id])
  replies       ChatMessage[]     @relation("ThreadReplies")
  reactions     MessageReaction[]

  @@unique([channelId, streamId]) // STRICT ORDERING CONSTRAINT
  @@index([channelId, createdAt(sort: Desc)])
  @@index([parentMessageId, createdAt(sort: Asc)])
  @@map("chat_messages")
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String @map("message_id")
  userId    String @map("user_id")
  emoji     String // The unicode char or shortcode

  createdAt DateTime @default(now()) @map("created_at")

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji]) // One reaction per type per user
  @@map("message_reactions")
}

enum MeetStatus {
  SCHEDULED
  LIVE
  ENDED
}

model Meet {
  id        String     @id @default(cuid())
  projectId String     @map("project_id")
  title     String
  startTime DateTime   @map("start_time")
  status    MeetStatus @default(SCHEDULED)

  startedAt DateTime? @map("started_at")
  endedAt   DateTime? @map("ended_at")

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants MeetParticipant[]

  @@index([projectId])
  @@map("meets")
}

model MeetParticipant {
  id       String    @id @default(cuid())
  meetId   String    @map("meet_id")
  userId   String    @map("user_id")
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")

  meet Meet @relation(fields: [meetId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("meet_participants")
}

model CollabifyAiConversation {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  title     String
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  messages CollabifyAiMessage[]

  @@map("collabify_ai_conversations")
}

model CollabifyAiMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  role           String
  content        String
  citationData   Json?
  createdAt      DateTime @default(now()) @map("created_at")

  conversation CollabifyAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("collabify_ai_messages")
}

enum NotificationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model NotificationOutbox {
  id              BigInt             @id @default(autoincrement())
  eventType       String             @map("event_type")
  payload         Json
  status          NotificationStatus @default(PENDING)
  deduplicationId String?            @unique @map("deduplication_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  processedAt     DateTime?          @map("processed_at")
  errorLog        Json?              @map("error_log")

  @@index([status, createdAt])
  @@map("notification_outbox")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  workspaceId  String?  @map("workspace_id")
  projectId    String?  @map("project_id")
  categoryKey  String   @map("category_key")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  pushEnabled  Boolean  @default(true) @map("push_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId, projectId, categoryKey], map: "unique_user_preference_scope")
  @@map("notification_preferences")
}

model Notification {
  id              String  @id @default(cuid())
  recipientUserId String  @map("recipient_user_id")
  actorId         String? @map("actor_id")
  entityType      String  @map("entity_type")
  entityId        String  @map("entity_id")
  category        String  @default("general")

  data Json

  isRead     Boolean @default(false) @map("is_read")
  isArchived Boolean @default(false) @map("is_archived")

  createdAt DateTime @default(now()) @map("created_at")

  recipient User  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  workspaceId String?
  project     Project?   @relation(fields: [projectId], references: [id])
  projectId   String?

  @@index([recipientUserId, isRead, createdAt(sort: Desc)])
  @@index([recipientUserId, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuditLog {
  id             String  @id @default(cuid())
  workspaceId    String  @map("workspace_id")
  actorUserId    String? @map("actor_user_id")
  action         String
  targetResource String  @map("target_resource")
  metadata       Json?

  createdAt DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model Plan {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)

  // Normalized Limits
  limits        PlanLimit[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model PlanLimit {
  id     String @id @default(cuid())
  planId String @map("plan_id")

  resourceKey String @map("resource_key")
  limitValue  Int    @map("limit_value")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  // INDEXING: Fast lookup for a specific checking a specific rule
  @@unique([planId, resourceKey])
  @@map("plan_limits")
}

model Subscription {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  planId String @map("plan_id")
  status String @default("ACTIVE")

  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  overrides SubscriptionOverride[]

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([status, endDate]) // For cron jobs finding expiring subs
  @@map("subscriptions")
}

model SubscriptionOverride {
  id             String @id @default(cuid())
  subscriptionId String @map("subscription_id")
  resourceKey    String @map("resource_key")
  limitValue     Int    @map("limit_value")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, resourceKey])
  @@map("subscription_overrides")
}

model UsageRecord {
  id          String  @id @default(cuid())
  userId      String? @map("user_id")
  workspaceId String? @map("workspace_id")

  resourceKey String    @map("resource_key")
  currentVal  Int       @default(0) @map("current_val")
  resetAt     DateTime? @map("reset_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceKey])
  @@unique([workspaceId, resourceKey])
  @@map("usage_records")
}
